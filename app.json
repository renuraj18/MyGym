{
  "expo": {
    "name": "MyGym",
    "slug": "mygym",
    "owner": "renuraj18",
    "scheme": "mygym",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "android": {
      "package": "com.renuraj.mygym",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#000000"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "cameraPermission": "MyGym uses the camera to take member photos.",
          "photosPermission": "MyGym uses your photos to set member photos."
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "MyGym uses biometrics to unlock the app."
        }
      ],
      "@react-native-google-signin/google-signin",
      "@react-native-community/datetimepicker"
    ],
    "extra": {
      "eas": {
        "projectId": "af4b49ea-7d1a-4b9e-b756-2ea37838f6af"
      }
    }
  }
}
