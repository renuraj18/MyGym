{
  "expo": {
    "name": "MyGym",
    "slug": "mygym",
    "scheme": "mygym",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "android": {
      "package": "com.renuraj.mygym",
      "adaptiveIcon": {
        "backgroundColor": "#C2410C"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "cameraPermission": "MyGym uses the camera to take member photos.",
          "photosPermission": "MyGym uses your photos to set member photos."
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "MyGym uses biometrics to unlock the app."
        }
      ],
      "@react-native-google-signin/google-signin",
      "@react-native-community/datetimepicker"
    ]
  }
}
